# Environment variables for Hire Tracker.
# Copy this file to .env for local settings. Never commit .env.
# No secrets are needed yet. Later phases add DATABASE_URL and the AI extraction key here.

# Optional, read by the Playwright tests. Set them in the shell, e.g. BASE_URL=... npm run test:e2e
# PORT=3000                       # port the test server starts on
# BASE_URL=http://localhost:3000  # run the tests against an app that is already running
