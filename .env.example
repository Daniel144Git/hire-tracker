# Environment variables for Hire Tracker.
# Copy this file to .env for local settings. Never commit .env.

# SQLite database file used by the app and by Prisma (path relative to the project root).
DATABASE_URL="file:./prisma/dev.db"

# Optional, read by the Playwright tests. Set them in the shell, e.g. BASE_URL=... npm run test:e2e
# PORT=3100                       # port the test server starts on
# BASE_URL=http://localhost:3100  # run the tests against an app that is already running
