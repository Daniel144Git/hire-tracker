// Data model for Hire Tracker. See docs/BRIEF.md, section 5.
//
// Conventions:
// - Calendar dates (start of hire, off-hire, despatch) are "YYYY-MM-DD" strings, never DateTime:
//   they are days, not instants, and must not shift with time zones.
// - Money is stored as whole pence (Int), never as a floating-point number.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Trade {
  MECH
  ELEC
  VENT
  DUCT
  BMS
}

enum PaymentTerms {
  END_OF_NEXT_MONTH
  NET_N
}

enum OrderStatus {
  ON_HIRE
  OFF_HIRED
  COLLECTED
}

enum InvoiceType {
  CONTINUATION
  RETURN
  SALE
}

enum CheckStatus {
  NOT_CHECKED
  CHECKED
  QUERIED
}

enum PaymentStatus {
  UNPAID
  PAID
  QUERIED
  CREDITED
}

enum ChargeType {
  HIRE
  DAMAGE_WAIVER
  TRANSPORT
  SALE
  OTHER
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

/// Why an invoice line could not be linked to a hire order or item.
enum LinkProblem {
  UNKNOWN_ORDER_REF
  UNKNOWN_JOB_NO
  UNKNOWN_FLEET_CODE
  AMBIGUOUS_FLEET_CODE
}

model Supplier {
  id                 String       @id @default(cuid())
  name               String       @unique
  accountNo          String?
  chargeBankHolidays Boolean      @default(true)
  minChargeDays      Int          @default(5)
  damageWaiverPct    Float        @default(10)
  paymentTerms       PaymentTerms @default(END_OF_NEXT_MONTH)
  paymentTermsDays   Int?
  orders             HireOrder[]
  invoices           Invoice[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Site {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  deliveryAddress String?
  orders          HireOrder[]
  suspensions     Suspension[]
  aliases         SiteAlias[]
  invoices        Invoice[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model HireOrder {
  id                  String        @id @default(cuid())
  supplierJobNo       String
  /// Our own order number, printed on some suppliers' invoices: the key from an invoice to the order.
  orderRef            String?       @unique
  supplier            Supplier      @relation(fields: [supplierId], references: [id])
  supplierId          String
  site                Site          @relation(fields: [siteId], references: [id])
  siteId              String
  trade               Trade
  startDate           String
  offHireDate         String?
  collectionNo        String?
  offHireEnteredAt    DateTime?
  damageWaiverApplies Boolean
  status              OrderStatus   @default(ON_HIRE)
  items               HireItem[]
  invoiceLines        InvoiceLine[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // The supplier's job number identifies one hire order and stays the same on every invoice.
  @@unique([supplierId, supplierJobNo])
  @@index([siteId, status])
}

model HireItem {
  id              String            @id @default(cuid())
  order           HireOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  description     String
  fleetCode       String?
  qty             Int               @default(1)
  weeklyRatePence Int
  despatchNo      String?
  despatchDate    String?
  isAccessory     Boolean           @default(false)
  invoiceLines    InvoiceLine[]
  codeChanges     FleetCodeChange[]
  createdAt       DateTime          @default(now())

  @@index([fleetCode])
}

/// An invoice as printed by the supplier. Amounts are stored exactly as billed, even when they
/// are wrong: finding what is wrong is the job of the reconciliation checks, not of data entry.
model Invoice {
  id              String        @id @default(cuid())
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  supplierId      String
  number          String
  date            String
  dueDate         String
  type            InvoiceType
  isCreditNote    Boolean       @default(false)
  /// The supplier's job / contract number printed in the header: one hire order.
  jobNo           String?
  /// Our own order number, when the invoice prints it (e.g. "Order No").
  orderRef        String?
  /// Delivery address printed on the invoice: a second signal to recognise the site.
  deliveryAddress String?
  /// The site of the invoice: from its linked orders, or recognised from the customer reference.
  site            Site?         @relation(fields: [siteId], references: [id])
  siteId          String?
  /// How the site was found: ORDER, ALIAS, NAME, CODE or POSTCODE.
  siteMatchedBy   String?
  /// "Last invoice" printed on continuation invoices: links the chain of a hire order.
  lastInvoiceNo   String?
  customerRef     String?
  netPence        Int
  vatPence        Int
  grossPence      Int
  filePath        String?
  checkStatus     CheckStatus   @default(NOT_CHECKED)
  paymentStatus   PaymentStatus @default(UNPAID)
  lines           InvoiceLine[]
  findings        Finding[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Duplicate invoice protection: an invoice number is unique per supplier.
  @@unique([supplierId, number])
  @@index([jobNo])
}

model InvoiceLine {
  id          String       @id @default(cuid())
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  position    Int
  order       HireOrder?   @relation(fields: [orderId], references: [id])
  orderId     String?
  hireItem    HireItem?    @relation(fields: [hireItemId], references: [id])
  hireItemId  String?
  linkProblem LinkProblem?
  fleetCode   String?
  description String
  qty         Int          @default(1)
  /// Billing period as printed. On credit notes From can be later than To.
  periodFrom  String?
  periodTo    String?
  weeks       Int?
  days        Int?
  ratePence   Int?
  chargeType  ChargeType
  netPence    Int
  vatPence    Int
  /// Overrides the order's trade for cost allocation.
  trade       Trade?
  findings    Finding[]

  @@index([orderId])
}

/// A discrepancy found by a reconciliation check (R1-R17) on an invoice.
/// Findings are recalculated every time the checks run on the invoice.
model Finding {
  id              String       @id @default(cuid())
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoiceLine     InvoiceLine? @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  invoiceLineId   String?
  check           String
  severity        Severity
  message         String
  billedPence     Int?
  expectedPence   Int?
  /// billed - expected: positive means overcharged.
  differencePence Int?
  /// True when the discrepancy is already settled, e.g. credited by a credit note.
  resolved        Boolean      @default(false)
  resolution      String?
  /// Position in the engine's order: most severe first, then by line.
  rank            Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([invoiceId])
}

/// A period when a site was closed and the supplier agreed to credit "free days" on every hire
/// order of that site (brief 4.1). Check R16 looks for that credit on the invoices.
model Suspension {
  id         String   @id @default(cuid())
  site       Site     @relation(fields: [siteId], references: [id])
  siteId     String
  periodFrom String
  periodTo   String
  /// Working days the supplier credits on each hire line of that period.
  freeDays   Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([siteId])
}

/// A customer reference as the supplier spells it ("RIVERSIDE", "Riverside Twr"), pointing to a site.
model SiteAlias {
  id     String @id @default(cuid())
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId String
  /// Stored normalised: upper case, letters and digits separated by single spaces.
  alias  String @unique
}

/// A change of an item's fleet code (E-code), e.g. when the supplier swaps the item.
model FleetCodeChange {
  id         String   @id @default(cuid())
  hireItem   HireItem @relation(fields: [hireItemId], references: [id], onDelete: Cascade)
  hireItemId String
  oldCode    String
  newCode    String
  changedOn  String
  note       String?
  createdAt  DateTime @default(now())

  @@index([hireItemId])
  @@index([oldCode])
}
